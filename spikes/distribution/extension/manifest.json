{
 "manifest_version": 3,
 "name": "GDM bridge spike",
 "version": "0.1.0",
 "description": "SPIKE ONLY: calls the gdm-bridge native host",
 "key": "",
 "permissions": [
  "nativeMessaging"
 ],
 "background": {
  "service_worker": "bg.js",
  "scripts": [
   "bg.js"
  ]
 },
 "browser_specific_settings": {
  "gecko": {
   "id": "gdm-spike@goldeniq.dev",
   "strict_min_version": "128.0"
  }
 }
}